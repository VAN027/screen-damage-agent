# 复制为 .env 后，用独立生成的高强度随机值替换前两项。
# 留空时 docker compose 会拒绝启动，避免服务在无鉴权状态下运行。
ADMIN_API_TOKEN=
INTERNAL_SERVICE_TOKEN=

# 只读 MCP Server 的独立访问令牌，至少32字符；建议使用 `openssl rand -hex 32` 生成。
MCP_API_TOKEN=
MCP_BIND_ADDRESS=127.0.0.1
MCP_PUBLISHED_PORT=8090
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,read-only-mcp
MCP_REQUESTS_PER_MINUTE=120

# 决策引擎已就绪后与管理中台已发布规则的对账周期（毫秒，最小 1000）。
RULE_RECONCILE_INTERVAL_MS=30000

# LLM 能力可选；留空时规则判定和 RAG 仍可运行。
LLM_API_KEY=
LLM_ANNO_API_KEY=

# 自定义 HTTPS 端点可填裸主机名；HTTP、私网或 Ollama 必须填精确 host:port 或完整 origin。
# 多项用逗号分隔，禁止通配符。默认本机 Ollama 只允许 loopback:11434。
# 示例：llm.example.com,10.0.0.8:11434,http://127.0.0.1:11434
LLM_ALLOWED_HOSTS=

# 纠错审核完成后，图片转存磁盘的保留天数（1-3650，默认 90）。到期只删图片，保留审核记录。
REVIEW_IMAGE_RETENTION_DAYS=90

# 仅跨域部署时填写完整 Origin（可逗号分隔）；同源访问无需配置。
CORS_ALLOWED_ORIGINS=

# Compose 默认只在本机发布网关，由 TLS 反向代理对外服务；确有隔离网络需求时再改绑定地址。
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PUBLISHED_PORT=8080
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PUBLISHED_PORT=8082

# 固定 Compose 内网网关，供 BFF 只信任宿主 Nginx 注入的 X-Forwarded-For。
# 若该网段与现有网络冲突，请成对修改 subnet 和 gateway，且不要加入不可信代理地址。
SCREEN_DAMAGE_SUBNET=172.30.240.0/24
SCREEN_DAMAGE_GATEWAY=172.30.240.1

# 公共计算预算：每实例生效；多副本部署需改用共享限流存储或按副本折算。
LLM_GLOBAL_REQUESTS_PER_MINUTE=30
LLM_GLOBAL_REQUESTS_PER_DAY=500
LLM_GLOBAL_CONCURRENCY=3
VECTOR_GLOBAL_CONCURRENCY=4

# false: 首次使用时下载并缓存模型；true: 仅使用已有缓存（离线部署）。
DINO_LOCAL_FILES_ONLY=false
DINO_MODEL_NAME=facebook/dinov2-small

# 图片方向预处理：OpenCV 负责电视长轴，OCR 比较 0/180° 文字证据。
# 关闭 OCR 后，无法由几何判断的上下方向会进入多模态兜底或人工确认。
ORIENTATION_OCR_ENABLED=true
ORIENTATION_OCR_LANG=ch

# 可选 Milvus；未配置时使用容器内存索引并持久化到 knowledge-data 卷。
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_REST_PORT=9091
