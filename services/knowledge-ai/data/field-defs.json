{
  "_comment": "集中式字段定义 — 唯一事实来源。所有前端面板、后端解析器、同步映射均引用此文件，修改一处即可全局生效。",
  "fields": {
    "statusObs": {
      "label": "状态观察",
      "type": "textarea",
      "required": false,
      "placeholder": "描述屏幕安装状态、保护膜情况、外观损伤痕迹等"
    },
    "location": {
      "label": "故障位置",
      "type": "tag-grid",
      "required": true,
      "options": [
        "天侧",
        "地侧",
        "左侧",
        "右侧",
        "四角区域",
        "中央区域",
        "全屏区域",
        "局部不规则区域"
      ]
    },
    "shape": {
      "label": "故障形态",
      "type": "tag-grid",
      "required": true,
      "options": [
        "单条线状屏裂",
        "多条线状屏裂",
        "点放射状屏裂",
        "发散性线状屏裂",
        "环状/圈状屏裂",
        "网状(大面积无规则)屏裂",
        "漏液",
        "熔屏"
      ],
      "caseMapping": {
        "漏液": "漏液（无缺角、裂纹、腐蚀）",
        "熔屏": "熔屏（无缺角、裂纹、腐蚀）"
      },
      "pillLabels": {
        "单条线状屏裂": "单条线状",
        "多条线状屏裂": "多条线状",
        "点放射状屏裂": "点放射状",
        "发散性线状屏裂": "发散性线状",
        "环状/圈状屏裂": "环状/圈状",
        "网状(大面积无规则)屏裂": "网状",
        "漏液": "漏液",
        "熔屏": "熔屏"
      }
    },
    "stage": {
      "label": "故障环节",
      "type": "tag-grid",
      "required": false,
      "options": [
        "产品因素",
        "物流运输搬运",
        "拆机验机安装",
        "使用保管不当"
      ],
      "codeMap": {
        "产品因素": "product_factor",
        "物流运输搬运": "logistics_transport",
        "拆机验机安装": "unboxing_install",
        "使用保管不当": "usage_mishandling"
      },
      "stageConsequenceMapping": {
        "产品因素": "product_quality_issue",
        "物流运输搬运": "not_product_quality",
        "拆机验机安装": "not_product_quality",
        "使用保管不当": "not_product_quality"
      }
    },
    "principle": {
      "label": "故障原理",
      "type": "textarea",
      "required": false,
      "placeholder": "描述损伤的形成机理和原因"
    },
    "conclusion": {
      "label": "鉴定结论",
      "type": "tag-grid",
      "required": false,
      "options": [
        {"value": "product_quality_issue", "label": "质量问题", "cssClass": "quality", "icon": "✅"},
        {"value": "not_product_quality", "label": "非质量问题", "cssClass": "npq", "icon": "❌"},
        {"value": "no_damage", "label": "屏幕完好", "cssClass": "", "icon": "📋"}
      ],
      "labelMap": {
        "product_quality_issue": "质量问题",
        "not_product_quality": "非质量问题",
        "no_damage": "屏幕完好"
      }
    }
